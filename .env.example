# Firebase Web Configuration for SignalSchool
# Copy this file to .env.local and populate with your Firebase project keys

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# Secure Serverless Backend Configuration
# (Kept secure on Vercel / Node dev server - NEVER leaked to browser!)
# ==========================================
# Resend API Key (Sign up free at https://resend.com - 3,000 emails/mo)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=SignalSchool <onboarding@resend.dev>

# Cryptographic Secret used to sign HMAC OTP tokens (generate any random string)
EMAIL_SERVER_SECRET=signalschool_super_secure_secret_signing_key_change_in_production

# ==========================================
# Email Delivery Provider (Client Fallback)
# ==========================================
VITE_EMAIL_PROVIDER=resend
VITE_RESEND_API_KEY=re_your_resend_api_key_here
VITE_RESEND_FROM=SignalSchool <onboarding@resend.dev>


