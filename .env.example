# Firebase Web Configuration for SignalSchool

VITE_FIREBASE_API_KEY = AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN = your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID = your-project-id
VITE_FIREBASE_STORAGE_BUCKET = your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID = 123456789012
VITE_FIREBASE_APP_ID = 1:123456789012:web:abcdef1234567890

FIREBASE_PROJECT_ID = project_id
FIREBASE_CLIENT_EMAIL = client_email_address
FIREBASE_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\n\n-----END PRIVATE KEY-----\n"

# ==========================================
# Email Delivery Provider (Modular Adapter)
# ==========================================
VITE_EMAIL_PROVIDER = resend

# Resend (Free: 3,000 emails/month, sign up at https://resend.com)
VITE_RESEND_API_KEY = re_your_resend_api_key_here
VITE_RESEND_FROM = SignalSchool <onboarding@resend.dev>